    {
      "cell_type": "code",
      "source": [
        "# Rule based chatbot\n",
        "def chatbot(user_input):\n",
        "  responses={\n",
        "      \"hello\": \"Hi there! Let us now learn about Pragati engineering college\",\n",
        "      \"what courses are offered?\": \"We offer B.Tech and M.Tech programs.\",\n",
        "      \"when do the admissions start?\":\"Admission details are available online at https://pragati.ac.in/.\",\n",
        "      \"what facilities are available\": \"The college has hostel for boys , a library , Canteen, computer labs , and sports facilities .\",\n",
        "      \"what branches are available\": \"The college offers many branches such as ECE, EEE, MECH, CIVIL, CSE, CSE(AI), CSE(DS), CSE(AI&ML), CS, IT .\",\n",
        "      \"bye\":\"Goodbye! Have a nice day\"\n",
        "  }\n",
        "  return responses.get(user_input.lower(),\"I don't understand\")\n",
        "while True:\n",
        "  user_input=(input(\"You: \"))\n",
        "  if user_input.lower()==\"exit\":\n",
        "    break\n",
        "  print(\"Bot: \",chatbot(user_input))"
      ],
