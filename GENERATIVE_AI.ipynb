    {
      "cell_type": "code",
      "source": [
        "#simple text summarizer program\n",
        "def summarize_text(text):\n",
        "  sentences=text.split(\".\")\n",
        "  summary=\".\".join(sentences[:2])\n",
        "  return summary\n",
        "text=input(\"Enter a long text:\")\n",
        "summary=summarize_text(text)\n",
        "print(\"Summary:\",summary)"
      ],
