        "# create a program that generates username based on user input\n",
        "# output: coolijyothiqueen76\n",
        "# prefix,anyname,suffix,any random number\n",
        "\n",
        "import random\n",
        "\n",
        "prefix = input(\"Enter a prefix for your username (e.g., 'cooli'): \")\n",
        "name = input(\"Enter your desired name for the username (e.g., 'jyothiqueen'): \")\n",
        "suffix = input(\"Enter a suffix for your username (optional, e.g., 'pro'): \")\n",
        "\n",
        "random_number = random.randint(0, 99)\n",
        "\n",
        "\n",
        "username = f\"{prefix}{name}{suffix}{random_number}\"\n",
        "\n",
        "print(f\"Generated Username: {username}\")"
